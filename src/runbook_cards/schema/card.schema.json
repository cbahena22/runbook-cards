{
  "title": "Runbook card",
  "type": "object",
  "additionalProperties": false,
  "required": ["card_id", "pack", "kind", "title", "playbook_link", "citations", "injection_found", "status",
               "status_reason", "source_shas", "prompt_version", "model"],
  "properties": {
    "card_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "pack": {"enum": ["security", "helpdesk"]},
    "kind": {"enum": ["alert", "procedure"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "what_it_is": {"type": "string" },
    "why_it_flags": {"type": "string" },
    "key_fields": {"type": "array", "items": {"type": "string" }},
    "triage_tips": {"type": "array", "items": {"type": "string" }},
    "when_to_use": {"type": "string" },
    "steps": {"type": "array", "items": {"type": "string" }},
    "checks": {"type": "array", "items": {"type": "string" }},
    "escalate_to": {"type": "string" },
    "queries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "esql": {"$ref": "#/$defs/query"},
        "kql": {"$ref": "#/$defs/query"}
      }
    },
    "attack": {"type": "array", "items": {"type": "string"}},
    "playbook_link": {"type": ["string", "null"]},
    "citations": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/span"}}},
    "injection_found": {"type": "array", "items": {"$ref": "#/$defs/span"}},
    "status": {"enum": ["grounded", "needs human"]},
    "status_reason": {"enum": [null, "budget", "timeout", "validator", "unsupported", "error"]},
    "unsupported_before": {"type": "integer", "minimum": 0, "maximum": 100},
    "unsupported_after": {"type": "integer", "minimum": 0, "maximum": 100},
    "source_shas": {"type": "array", "items": {"type": "object", "required": ["doc_id", "sha256"], "additionalProperties": false, "properties": {"doc_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "prompt_version": {"type": "string"},
    "model": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "grounded"}}},
      "then": {"properties": {"status_reason": {"const": null}}}
    },
    {
      "if": {"properties": {"status": {"const": "needs human"}}},
      "then": {"properties": {"status_reason": {"type": "string"}}}
    },
    {
      "if": {"properties": {"pack": {"const": "security"}}},
      "then": {"required": ["what_it_is", "why_it_flags", "key_fields", "triage_tips", "queries", "attack"]}
    },
    {
      "if": {"properties": {"pack": {"const": "helpdesk"}}},
      "then": {"required": ["what_it_is", "when_to_use", "steps", "checks", "escalate_to"]}
    }
  ],
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "start_line", "end_line", "quote"],
      "properties": {
        "doc_id": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "error", "field_map"],
      "properties": {
        "query": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "field_map": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}
      }
    }
  }
}

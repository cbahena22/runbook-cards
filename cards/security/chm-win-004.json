      "field_map": {
        "CommandLine": "ProcessCommandLine",
        "Image": "FolderPath"
      },
      "query": "DeviceProcessEvents\n| where FolderPath endswith \"\\\\bitsadmin.exe\" and (ProcessCommandLine contains \"/transfer\" or ProcessCommandLine contains \"/addfile\")"
    }

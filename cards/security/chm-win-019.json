  "queries": {
    "esql": {
      "error": null,
      "field_map": {
        "CommandLine": "process.command_line",
        "Image": "process.executable.caseless"
      },
      "query": "from * metadata _id, _index, _version | where ends_with(process.executable.caseless, \"\\\\whoami.exe\") and (process.command_line like \"*/priv*\" or process.command_line like \"*/groups*\")"
    },
    "kql": {
      "error": null,
      "field_map": {
        "CommandLine": "ProcessCommandLine",
        "Image": "FolderPath"
      },
      "query": "DeviceProcessEvents\n| where FolderPath endswith \"\\\\whoami.exe\" and (ProcessCommandLine contains \"/priv\" or ProcessCommandLine contains \"/groups\")"
    }
  },
